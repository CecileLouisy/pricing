ENV=local
# Local development: SQLite file. Production: Neon PostgreSQL connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./pricing.db
ADMIN_TOKEN=change-me-in-production
# API keys of the calling services (X-API-Key header). In production (ENV=production)
# the service refuses to start if a secret is missing, left at its default or shorter than 16 characters.
BOOKING_API_KEY=local-booking-key-change-me
ACCESS_API_KEY=local-access-key-change-me
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
